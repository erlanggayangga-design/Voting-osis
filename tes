        { kode: "PS015", pass: "123456", nama: "Oki Darmawan", kelas: "X-B" },
        { kode: "PS016", pass: "123456", nama: "Putri Amelia", kelas: "X-B" },
        { kode: "PS017", pass: "123456", nama: "Qori Rachman", kelas: "X-A" },
        { kode: "PS018", pass: "123456", nama: "Rina Marlina", kelas: "X-A" },
        { kode: "PS019", pass: "123456", nama: "Surya Pratama", kelas: "X-B" },
        { kode: "PS020", pass: "123456", nama: "Tiara Andini", kelas: "X-B" }
    ];

    const dataGuru = [
        { kode: "GURU01", pass: "guru123", nama: "Bu Ani (Wali Kelas)" },
        { kode: "ADMIN01", pass: "admin123", nama: "Administrator Sistem" }
    ];

    let currentStudentCode = null;
    let viewingStudentCode = null;

    function doLogin() {
        const inputKode = document.getElementById('input-kode').value.toUpperCase();
        const inputPass = document.getElementById('input-pass').value;

        const guruDitemukan = dataGuru.find(g => g.kode === inputKode && g.pass === inputPass);
        if (guruDitemukan) {
            document.getElementById('admin-name').innerText = "Selamat Datang, " + guruDitemukan.nama;
            document.getElementById('login-view').classList.add('hidden');
            document.getElementById('admin-view').classList.remove('hidden');
            loadAdminDashboard();
            resetLoginForm();
            return;
        }

        const siswaDitemukan = dataSiswa.find(s => s.kode === inputKode && s.pass === inputPass);
        if (siswaDitemukan) {
            currentStudentCode = siswaDitemukan.kode;
            document.getElementById('user-name-home').innerText = "Halo, " + siswaDitemukan.nama;
            document.getElementById('user-name-profile').innerText = siswaDitemukan.nama;
            document.getElementById('user-nis-profile').innerText = "NIS: " + siswaDitemukan.kode + " | Kelas: " + siswaDitemukan.kelas;

            loadStudentDataIntoForm();
            updateDashboardStatus();
            checkGlobalNotification();

            document.getElementById('login-view').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            resetLoginForm();
            return;
        }

        alert("Kode atau Password salah! Periksa kembali ketikanmu.");
