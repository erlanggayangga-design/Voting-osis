    function collectFormFields() {
        return {
            jurnal: {
                perasaan: document.getElementById('inp-jurnal-perasaan').value,
                kegiatan: document.getElementById('inp-jurnal-kegiatan').value,
                belajar: document.getElementById('inp-jurnal-belajar').value,
                refleksi: document.getElementById('inp-jurnal-refleksi').value
            },
            literasi: {
                judul: document.getElementById('inp-lit-judul').value,
                sumber: document.getElementById('inp-lit-sumber').value,
                ringkasan: document.getElementById('inp-lit-ringkasan').value,
                refleksi: document.getElementById('inp-lit-refleksi').value
            },
            numerasi: {
                topik: document.getElementById('inp-num-topik').value,
                soal: document.getElementById('inp-num-soal').value,
                jawaban: document.getElementById('inp-num-jawaban').value,
                cara: document.getElementById('inp-num-cara').value
            },
            target: {
                teks: document.getElementById('inp-target-teks').value,
                waktu: document.getElementById('inp-target-waktu').value
            },
            waktu: {
                kegiatan: document.getElementById('inp-waktu-kegiatan').value,
                mulai: document.getElementById('inp-waktu-mulai').value,
                selesai: document.getElementById('inp-waktu-selesai').value,
                ket: document.getElementById('inp-waktu-ket').value,
                ingat: document.getElementById('inp-waktu-ingat').checked
            },
            lingkungan: {
                kat: document.getElementById('inp-ling-kat').value,
                lokasi: document.getElementById('inp-ling-lokasi').value,
                laporan: document.getElementById('inp-ling-laporan').value,
                saran: document.getElementById('inp-ling-saran').value
            }
        };
    }

    function autoSave() {
        if (!currentStudentCode) return;
        const data = collectFormFields();
        localStorage.setItem('draft_' + currentStudentCode, JSON.stringify(data));
        
        let historyMeta = JSON.parse(localStorage.getItem('history_' + currentStudentCode) || '{}');
        if (!historyMeta.createdAt) {
            historyMeta.createdAt = new Date().toLocaleString('id-ID');
        }
        historyMeta.updatedAt = new Date().toLocaleString('id-ID');
        localStorage.setItem('history_' + currentStudentCode, JSON.stringify(historyMeta));

        updateProgressIndicators(data);
    }

    function loadStudentDataIntoForm() {
        if (!currentStudentCode) return;
        
        const rawDraft = localStorage.getItem('draft_' + currentStudentCode);
        const rawFinal = localStorage.getItem('data_jurnal_' + currentStudentCode);
        const sourceData = rawFinal ? JSON.parse(rawFinal) : (rawDraft ? JSON.parse(rawDraft) : null);

        if (sourceData) {
            if (sourceData.jurnal) {
                document.getElementById('inp-jurnal-perasaan').value = sourceData.jurnal.perasaan || '';
                document.getElementById('inp-jurnal-kegiatan').value = sourceData.jurnal.kegiatan || '';
                document.getElementById('inp-jurnal-belajar').value = sourceData.jurnal.belajar || '';
                document.getElementById('inp-jurnal-refleksi').value = sourceData.jurnal.refleksi || '';
            }
            if (sourceData.literasi) {
                document.getElementById('inp-lit-judul').value = sourceData.literasi.judul || '';
                document.getElementById('inp-lit-sumber').value = sourceData.literasi.sumber || '';
                document.getElementById('inp-lit-ringkasan').value = sourceData.literasi.ringkasan || '';
                document.getElementById('inp-lit-refleksi').value = sourceData.literasi.refleksi || '';
            }
            if (sourceData.numerasi) {
                document.getElementById('inp-num-topik').value = sourceData.numerasi.topik || '';
                document.getElementById('inp-num-soal').value = sourceData.numerasi.soal || '';
                document.getElementById('inp-num-jawaban').value = sourceData.numerasi.jawaban || '';
                document.getElementById('inp-num-cara').value = sourceData.numerasi.cara || '';
            }
            if (sourceData.target) {
                document.getElementById('inp-target-teks').value = sourceData.target.teks || '';
                document.getElementById('inp-target-waktu').value = sourceData.target.waktu || '';
            }
            if (sourceData.waktu) {
                document.getElementById('inp-waktu-kegiatan').value = sourceData.waktu.kegiatan || '';
                document.getElementById('inp-waktu-mulai').value = sourceData.waktu.mulai || '';
                document.getElementById('inp-waktu-selesai').value = sourceData.waktu.selesai || '';
                document.getElementById('inp-waktu-ket').value = sourceData.waktu.ket || '';
                document.getElementById('inp-waktu-ingat').checked = !!sourceData.waktu.ingat;
            }
            if (sourceData.lingkungan) {
                document.getElementById('inp-ling-kat').value = sourceData.lingkungan.kat || 'Kebersihan';
                document.getElementById('inp-ling-lokasi').value = sourceData.lingkungan.lokasi || '';
                document.getElementById('inp-ling-laporan').value = sourceData.lingkungan.laporan || '';
                document.getElementById('inp-ling-saran').value = sourceData.lingkungan.saran || '';
            }
            updateProgressIndicators(sourceData);
        }

        const historyMeta = JSON.parse(localStorage.getItem('history_' + currentStudentCode) || '{}');
        document.getElementById('history-created-time').innerText = historyMeta.createdAt ? `Dibuat: ${historyMeta.createdAt} | Diedit: ${historyMeta.updatedAt || '-'}` : "Belum ada aktivitas";

        const teacherFeedback = JSON.parse(localStorage.getItem('feedback_' + currentStudentCode) || '{}');
        document.getElementById('student-notes-view').innerText = teacherFeedback.note || "Belum ada catatan dari guru.";
        
        if (teacherFeedback.grades) {
            const g = teacherFeedback.grades;
            const avg = Math.round(((parseInt(g.jurnal)||0) + (parseInt(g.literasi)||0) + (parseInt(g.numerasi)||0) + (parseInt(g.target)||0)) / 4);
            document.getElementById('student-grades-view').innerHTML = `
                Jurnal Diri: <strong>${g.jurnal || 0}</strong><br>
                Literasi: <strong>${g.literasi || 0}</strong><br>
                Numerasi: <strong>${g.numerasi || 0}</strong><br>
                Target Belajar: <strong>${g.target || 0}</strong><br>
                <hr style="border:0; border-top:1px solid var(--border-color); margin:5px 0;">
                Total Rata-rata: <strong>${avg}</strong>
            `;
        }
    }

    function updateProgressIndicators(data) {
        let completed = 0;
        
        if (data.jurnal && (data.jurnal.kegiatan || data.jurnal.belajar)) {
            completed++;
            document.getElementById('icon-m1').innerText = "✅";
        } else { document.getElementById('icon-m1').innerText = "📝"; }

        if (data.literasi && (data.literasi.judul || data.literasi.ringkasan)) {
            completed++;
            document.getElementById('icon-m2').innerText = "✅";
        } else { document.getElementById('icon-m2').innerText = "📚"; }

        if (data.numerasi && (data.numerasi.topik || data.numerasi.soal)) {
            completed++;
            document.getElementById('icon-m3').innerText = "✅";
        } else { document.getElementById('icon-m3').innerText = "🔢"; }

        if (data.target && data.target.teks) {
            completed++;
            document.getElementById('icon-m4').innerText = "✅";
        } else { document.getElementById('icon-m4').innerText = "🎯"; }

        if (data.waktu && data.waktu.kegiatan) {
            completed++;
            document.getElementById('icon-m5').innerText = "✅";
        } else { document.getElementById('icon-m5').innerText = "⏰"; }

        if (data.lingkungan && data.lingkungan.laporan) {
            completed++;
            document.getElementById('icon-m6').innerText = "✅";
        } else { document.getElementById('icon-m6').innerText = "🏫"; }

        document.getElementById('status-count').innerText = completed + "/6";
    }

    function updateDashboardStatus() {
        const isSubmitted = localStorage.getItem('submitted_' + currentStudentCode) === 'true';
        const statusText = document.getElementById('status-text');
        const lockedBanner = document.getElementById('locked-banner');
        const historyBadge = document.getElementById('history-badge');
        const historyDesc = document.getElementById('history-status-desc');
        const submitSection = document.getElementById('submit-section');
        const submitTimestamp = document.getElementById('submit-timestamp');

        if (isSubmitted) {
            statusText.innerText = "Final (Terkunci)";
            statusText.style.color = "var(--success)";
            lockedBanner.classList.remove('hidden');
            submitSection.classList.add('hidden');
            historyBadge.innerText = "Selesai";
            historyBadge.style.backgroundColor = "var(--success)";
            
            const timeStr = localStorage.getItem('time_' + currentStudentCode) || '-';
            historyDesc.innerText = `Dikirim: ${timeStr}`;
            submitTimestamp.innerText = `Dikirim: ${timeStr}`;
            
            disableAllInputs(true);
        } else {
            statusText.innerText = "Belum Final";
            statusText.style.color = "var(--warning)";
            lockedBanner.classList.add('hidden');
            submitSection.classList.remove('hidden');
            historyBadge.innerText = "Belum";
            historyBadge.style.backgroundColor = "var(--warning)";
            historyDesc.innerText = "Draft tersimpan (Bisa diedit)";
            disableAllInputs(false);
        }
    }

    function disableAllInputs(disable) {
        const elements = document.querySelectorAll('#content-area input, #content-area textarea, #content-area select');
        elements.forEach(el => el.disabled = disable);
    }

    function checkGlobalNotification() {
        const broadcast = localStorage.getItem('global_announcement');
        const banner = document.getElementById('notif-banner');
        const preview = document.getElementById('notif-text-preview');
        const modalBody = document.getElementById('modal-notif-body');

        if (broadcast) {
            banner.classList.remove('hidden');
            preview.innerText = broadcast;
            modalBody.innerText = broadcast;
        } else {
            banner.classList.add('hidden');
            modalBody.innerText = "Belum ada pengumuman baru dari guru.";
        }
    }

    function openNotificationModal() {
        document.getElementById('notification-modal').classList.remove('hidden');
    }
    function closeNotificationModal() {
        document.getElementById('notification-modal').classList.add('hidden');
    }

    function resetLoginForm() {
        document.getElementById('input-kode').value = '';
        document.getElementById('input-pass').value = '';
    }

    function doLogout() {
        currentStudentCode = null;
        document.getElementById('main-view').classList.add('hidden');
        document.getElementById('admin-view').classList.add('hidden');
        document.getElementById('login-view').classList.remove('hidden');
        switchNav('page-home', document.querySelector('.nav-item')); 
    }

    function switchNav(pageId, element) {
        const allPages = document.querySelectorAll('#content-area > div');
        allPages.forEach(page => page.classList.add('hidden'));
        document.getElementById(pageId).classList.remove('hidden');

        const navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(nav => nav.classList.remove('active'));
        element.classList.add('active');
        
        document.getElementById('bottom-nav').style.display = 'flex';
    }

    function openModule(moduleId) {
        const allPages = document.querySelectorAll('#content-area > div');
        allPages.forEach(page => page.classList.add('hidden'));

        document.getElementById(moduleId).classList.remove('hidden');
        document.getElementById('bottom-nav').style.display = 'none';
        window.scrollTo(0,0);
    }

    function closeModule() {
        autoSave();
        const allPages = document.querySelectorAll('#content-area > div');
        allPages.forEach(page => page.classList.add('hidden'));
        
        document.getElementById('page-home').classList.remove('hidden');
        document.getElementById('bottom-nav').style.display = 'flex';
    }

    function confirmSubmit() {
        const isSubmitted = localStorage.getItem('submitted_' + currentStudentCode) === 'true';
        if (isSubmitted) {
            alert("Jurnal ini sudah dikirim sebelumnya!");
            return;
        }

        const data = collectFormFields();
        
        if (!data.jurnal.kegiatan) { alert("⚠️ Modul Jurnal Diri belum diisi lengkap. Lengkapi terlebih dahulu."); return; }
        if (!data.literasi.judul) { alert("⚠️ Modul Literasi belum diisi lengkap. Lengkapi terlebih dahulu."); return; }
        if (!data.numerasi.topik) { alert("⚠️ Modul Numerasi belum diisi lengkap. Lengkapi terlebih dahulu."); return; }
        if (!data.target.teks) { alert("⚠️ Modul Target Belajar belum diisi lengkap. Lengkapi terlebih dahulu."); return; }
        if (!data.waktu.kegiatan) { alert("⚠️ Modul Manajemen Waktu belum diisi lengkap. Lengkapi terlebih dahulu."); return; }
        if (!data.lingkungan.laporan) { alert("⚠️ Modul Lapor Lingkungan belum diisi lengkap. Lengkapi terlebih dahulu."); return; }

        document.getElementById('confirm-modal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('confirm-modal').classList.add('hidden');
    }

    function executeSubmit() {
        closeModal();
        const data = collectFormFields();
        const timeNow = new Date().toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' });

        localStorage.setItem('submitted_' + currentStudentCode, 'true');
        localStorage.setItem('data_jurnal_' + currentStudentCode, JSON.stringify(data));
        localStorage.setItem('time_' + currentStudentCode, timeNow);

        alert("Jurnal berhasil dikirim dan dikunci permanen!");
        updateDashboardStatus();
    }

    function loadAdminDashboard() {
        let total = dataSiswa.length;
        let submitted = 0;

        dataSiswa.forEach(s => {
            if (localStorage.getItem('submitted_' + s.kode) === 'true') submitted++;
        });

        document.getElementById('stat-total').innerText = total;
        document.getElementById('stat-submitted').innerText = submitted;
        document.getElementById('stat-unsubmitted').innerText = total - submitted;
        document.getElementById('stat-percent').innerText = Math.round((submitted / total) * 100) + "%";

        filterAdminList();
    }

    function filterAdminList() {
        const query = document.getElementById('admin-search').value.toLowerCase();
        const statusFilter = document.getElementById('admin-filter-status').value;
        const classFilter = document.getElementById('admin-filter-class').value;

        let listHtml = "";
        dataSiswa.forEach(siswa => {
            const isSub = localStorage.getItem('submitted_' + siswa.kode) === 'true';
            
            if (siswa.kelas !== classFilter) return;
            if (statusFilter === 'submitted' && !isSub) return;
            if (statusFilter === 'unsubmitted' && isSub) return;
            if (query && !siswa.nama.toLowerCase().includes(query) && !siswa.kode.toLowerCase().includes(query)) return;

            listHtml += `
                <div class="list-item">
                    <div><strong>${siswa.nama}</strong><br><span style="font-size:12px; color:var(--text-muted);">NIS: ${siswa.kode} | ${siswa.kelas}</span></div>
                    <div>
                        ${isSub ? 
                            `<span class="badge" style="background:var(--success); margin-right:6px;">Sudah</span>
                             <button onclick="openTeacherDetail('${siswa.kode}')" style="background:var(--primary); color:white; border:none; padding:5px 8px; border-radius:5px; cursor:pointer; font-size:11px;">Periksa</button>` : 
                            `<span class="badge" style="background:var(--warning)">Belum</span>`
                        }
                    </div>
                </div>
            `;
        });

        document.getElementById('admin-student-list').innerHTML = listHtml || "<p style='font-size:13px; color:var(--text-muted); text-align:center;'>Tidak ada siswa ditemukan.</p>";
    }

    function openTeacherDetail(kodeSiswa) {
        const siswa = dataSiswa.find(s => s.kode === kodeSiswa);
        const rawData = localStorage.getItem('data_jurnal_' + kodeSiswa);
        viewingStudentCode = kodeSiswa;

        document.getElementById('detail-modal-title').innerText = `Periksa Jurnal: ${siswa.nama} (${siswa.kode})`;

        if (!rawData) {
            document.getElementById('detail-modal-content').innerHTML = "<p>Belum ada data final dikirim.</p>";
        } else {
            const d = JSON.parse(rawData);
            let html = `
                <p><strong>1. Jurnal Diri:</strong><br>- Perasaan: ${d.jurnal.perasaan}<br>- Kegiatan: ${d.jurnal.kegiatan}<br>- Belajar: ${d.jurnal.belajar}<br>- Refleksi: ${d.jurnal.refleksi}</p><br>
                <p><strong>2. Literasi:</strong><br>- Judul: ${d.literasi.judul}<br>- Sumber: ${d.literasi.sumber}<br>- Ringkasan: ${d.literasi.ringkasan}<br>- Refleksi: ${d.literasi.refleksi}</p><br>
                <p><strong>3. Numerasi:</strong><br>- Topik: ${d.numerasi.topik}<br>- Soal: ${d.numerasi.soal}<br>- Jawaban: ${d.numerasi.jawaban}<br>- Cara: ${d.numerasi.cara}</p><br>
                <p><strong>4. Target Belajar:</strong><br>- Target: ${d.target.teks}<br>- Waktu: ${d.target.waktu}</p><br>
                <p><strong>5. Manajemen Waktu:</strong><br>- Kegiatan: ${d.waktu.kegiatan}<br>- Jam: ${d.waktu.mulai}-${d.waktu.selesai}</p><br>
                <p><strong>6. Lingkungan:</strong><br>- Kategori: ${d.lingkungan.kat}<br>- Laporan: ${d.lingkungan.laporan}</p>
            `;
            document.getElementById('detail-modal-content').innerHTML = html;
        }

        const existingFeedback = JSON.parse(localStorage.getItem('feedback_' + kodeSiswa) || '{}');
        document.getElementById('grade-jurnal').value = existingFeedback.grades?.jurnal || '';
        document.getElementById('grade-literasi').value = existingFeedback.grades?.literasi || '';
        document.getElementById('grade-numerasi').value = existingFeedback.grades?.numerasi || '';
        document.getElementById('grade-target').value = existingFeedback.grades?.target || '';
        document.getElementById('admin-teacher-note').value = existingFeedback.note || '';

        document.getElementById('detail-modal').classList.remove('hidden');
    }

    function closeDetailModal() {
        document.getElementById('detail-modal').classList.add('hidden');
    }

    function saveTeacherGrading() {
        if (!viewingStudentCode) return;
        const feedback = {
            grades: {
                jurnal: document.getElementById('grade-jurnal').value,
                literasi: document.getElementById('grade-literasi').value,
                numerasi: document.getElementById('grade-numerasi').value,
                target: document.getElementById('grade-target').value
            },
            note: document.getElementById('admin-teacher-note').value
        };

        localStorage.setItem('feedback_' + viewingStudentCode, JSON.stringify(feedback));
        alert("Nilai dan catatan berhasil disimpan untuk siswa!");
        closeDetailModal();
    }

    function saveAdminBroadcast() {
        const text = document.getElementById('admin-broadcast-input').value;
        if (!text) { alert("Tulis pengumuman terlebih dahulu."); return; }
        localStorage.setItem('global_announcement', text);
        alert("Pengumuman berhasil disiarkan ke semua siswa!");
    }

    function downloadAllRekap() {
        let csvContent = "NIS,Nama,Kelas,Status,Waktu_Kirim,Jurnal_Perasaan,Literasi_Judul,Numerasi_Topik\n";

        dataSiswa.forEach(s => {
            const isSub = localStorage.getItem('submitted_' + s.kode) === 'true';
            const timeSub = localStorage.getItem('time_' + s.kode) || '-';
            if (isSub) {
                const raw = localStorage.getItem('data_jurnal_' + s.kode);
                if (raw) {
                    const d = JSON.parse(raw);
                    csvContent += `${s.kode},"${s.nama}",${s.kelas},Selesai,"${timeSub}","${d.jurnal.perasaan}","${d.literasi.judul}","${d.numerasi.topik}"\n`;
                }
            } else {
                csvContent += `${s.kode},"${s.nama}",${s.kelas},Belum,-,-,-,-\n`;
            }
        });

        const element = document.createElement('a');
        element.setAttribute('href', 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvContent));
        element.setAttribute('download', 'Rekap_Jurnal_Siswa.csv');
        element.style.display = 'none';
        document.body.appendChild(element);
        element.click();
        document.body.removeChild(element);
    }

    function toggleTheme() {
        document.body.classList.toggle('dark-mode');
    }
</script>

